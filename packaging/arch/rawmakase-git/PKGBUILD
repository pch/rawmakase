# Maintainer: pch <https://github.com/pch>
pkgname=rawmakase-git
pkgver=0.6.1
pkgrel=1
# ONNX Runtime for Subject, Sky and Background selection: the release every other
# package bundles (packaging/onnxruntime.py), not Arch's onnxruntime-cpu. It comes
# from Microsoft's NuGet package, since its GitHub releases are gone; the libraries
# are the same as those releases'.
_ortver=1.23.2
pkgdesc='A fast, non-destructive RAW photo developer (development version)'
arch=('x86_64' 'aarch64')
url='https://github.com/pch/rawmakase'
license=('MIT')
depends=('gcc-libs' 'glibc' 'hicolor-icon-theme' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland' 'libx11' 'libxcb' 'libxcursor' 'libxi' 'libxrandr' 'libglvnd')
optdepends=('xdg-desktop-portal: native file dialogs'
            'libheif: showing HEIC photos')
makedepends=('cargo' 'git' 'pkgconf')
# makepkg's LTO flags turn bundled C code (SQLite) into GCC bytecode rustc
# cannot link.
options=('!lto' '!debug')
provides=('rawmakase')
conflicts=('rawmakase')
source=('rawmakase::git+https://github.com/pch/rawmakase.git')
sha256sums=('SKIP')
# One package for both architectures. It stays per architecture so that the
# release workflow's rewrite of `sha256sums` keeps applying to the app's source only.
_ortnuget="microsoft.ml.onnxruntime.$_ortver.nupkg::https://api.nuget.org/v3-flatcontainer/microsoft.ml.onnxruntime/$_ortver/microsoft.ml.onnxruntime.$_ortver.nupkg"
source_x86_64=("$_ortnuget")
source_aarch64=("$_ortnuget")
sha256sums_x86_64=('25fe172f7fcdf34f2b5b02c8b997f6b88abc282956849d4af4335af23d0c4e4a')
sha256sums_aarch64=('25fe172f7fcdf34f2b5b02c8b997f6b88abc282956849d4af4335af23d0c4e4a')
# Extracted in package(), only the files it installs.
noextract=("microsoft.ml.onnxruntime.$_ortver.nupkg")

pkgver() {
  cd rawmakase
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "rawmakase"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "rawmakase"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The app and the bundled extensions' programs (MCP, MIDI, AI masks), which
  # `make install` puts in /usr/lib/rawmakase, where the app looks for them.
  cargo build --frozen --release -p rawmakase -p rawmakase-mcp -p rawmakase-midi -p rawmakase-ai-masks
}

check() {
  cd "rawmakase"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  # The app's tests run `rawmakase mcp`, which runs its program beside it,
  # and the MIDI and AI masks programs found there.
  cargo build --frozen -p rawmakase-mcp -p rawmakase-midi -p rawmakase-ai-masks
  cargo test --frozen
}

package() {
  cd "rawmakase"
  make install DESTDIR="$pkgdir" PREFIX=/usr PKGNAME="$pkgname"
  # The app opens the runtime lazily from /usr/lib/rawmakase
  # (crates/rawmakase-inference/src/runtime.rs); nothing links it.
  local ort="$srcdir/onnxruntime-$_ortver" rid="linux-${CARCH/x86_64/x64}"
  rid="${rid/aarch64/arm64}"
  mkdir -p "$ort"
  bsdtar -xf "$srcdir/microsoft.ml.onnxruntime.$_ortver.nupkg" -C "$ort" \
    "runtimes/$rid/native/libonnxruntime.so" LICENSE ThirdPartyNotices.txt
  install -Dm755 "$ort/runtimes/$rid/native/libonnxruntime.so" "$pkgdir/usr/lib/rawmakase/libonnxruntime.so"
  install -Dm644 "$ort/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/onnxruntime-LICENSE"
  install -Dm644 "$ort/ThirdPartyNotices.txt" "$pkgdir/usr/share/licenses/$pkgname/onnxruntime-ThirdPartyNotices.txt"
}
